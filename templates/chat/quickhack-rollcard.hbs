<div class="rollcard">

  <div class="rollcard-top">
    <div class="cpr-block">
      <div class="text-center text-normal text-semi">
        {{rollTitle}}
      </div>
      <div class="text-center text-small">
        Quickhack
      </div>
    </div>
  </div>

  <div class="rollcard-bottom">
    <div class="cpr-block">
      <div class="d10-rollcard-data">
        <div class="d10-dice-div">
          <img class="d10" src="systems/cyberpunk-red-core/icons/dice/black/d10_{{initialRoll}}.svg">
        </div>
        <div class="d10-number-div">
          {{resultTotal}}
        </div>
        <div class="d10-data-div">
          <div class="text-center">
            {{#if success}}
              SUCCESS
            {{else}}
              FAILURE
            {{/if}}
          </div>
        </div>
      </div>
    </div>
  </div>

</div>